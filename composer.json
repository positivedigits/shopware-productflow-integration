{
    "name": "positivedigits/shopware-productflow-integration",
    "description": "positivedigits/shopware-productflow-integration",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "shopware/core": "~6.7.0"
    },
    "extra": {
        "shopware-plugin-class": "PositiveDigits\\ProductFlowIntegration",
        "label": {
            "en-GB": "PositiveDigits — ProductFlow Integration"
        }
    },
    "autoload": {
        "psr-4": {
            "PositiveDigits\\": "src/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.4"
    },
    "scripts": {
        "all": [
            "@phpstan",
            "@php-cs",
            "@rector"
        ],
        "phpstan": "@php vendor/bin/phpstan analyze",
        "php-cs": "@php vendor/bin/php-cs-fixer fix --verbose --diff --dry-run",
        "php-cs-fix": "@php vendor/bin/php-cs-fixer fix --verbose --diff",
        "rector": "@php vendor/bin/rector process --dry-run",
        "rector-fix": "@php vendor/bin/rector process"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": false
        }
    }
}
